# util
mjai_bot/mortal*

# Locally-built bot release artifacts
mortal.zip
*.bot.zip
tests/mortal_zip_layout.rs

# Test
test

# Local release helper
scripts/tag_release.sh

# Training-data shards written by native_bot's extractor (see native_bot/train/README.md).
